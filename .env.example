# Copy to .env for local dev. On the VPS this file is generated once by
# deploy/setup-server.sh (see PUBLIC_HOSTNAME in that script) and then only
# hand-edited for real secrets — it's never checked in.

APP_PORT=8095
# On the VPS this is a random-label sslip.io hostname pointing at the box's
# IP (e.g. http://quirky-comet.62-171-156-198.sslip.io:8095) rather than the
# raw IP — readable, and ready for a real TLS cert later without owning DNS.
PUBLIC_URL=http://localhost:8095
STATIC_DIR=./static

# Local dev default matches docker-compose.yml's db service. In production
# this points at 127.0.0.1:5434 (see deploy/ — Postgres runs in Docker on
# the VPS but is not exposed beyond localhost).
DATABASE_URL=postgres://callit:secret@localhost:5434/callit_db?sslmode=disable

# openssl rand -hex 32
JWT_SECRET=change-me-in-production

# --- Panta ---
# Server-side only, never shipped to the Flutter app. Get one:
#   1. POST https://live-api.panta.market/api/v1/auth/register/ {email,password,name}
#   2. POST .../account/keys/ with the returned `access` bearer token, {"env":"test"}
#   3. copy the one-time `secret` field from the response (starts pk_test_)
PANTA_API_BASE=https://live-api.panta.market/api/v1
PANTA_API_KEY=
# Not published as a fixed value by Panta; PRD says "often 200bps" — confirm
# against the live MarketConfig once you have real trades to check against.
PANTA_PRIMARY_FEE_BPS=200
# "true" runs the whole create/buy/claim pipeline against in-memory fixtures
# instead of the live API — no key needed above. Set to "false" once
# PANTA_API_KEY is real.
PANTA_MOCK=true

# --- AI compiler ---
# Fast & free on Groq: console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Or Anthropic: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Same idea as PANTA_MOCK — a deterministic fake draft, no key needed.
AI_MOCK=true

# --- Email (OTP signup code) ---
# resend.com -> API Keys.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=auth@callit.my
RESEND_SENDER_NAME=Callit
